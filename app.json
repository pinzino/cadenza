{
  "expo": {
    "name": "cadenza",
    "slug": "cadenza",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cadenza",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Consenti a Cadenza di trascrivere i task dettati.",
        "NSMicrophoneUsageDescription": "Consenti a Cadenza di usare il microfono per inserire i task vocalmente."
      }
    },
    "android": {
      "package": "com.pinzino.cadenza",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#305D4A",
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Consenti a Cadenza di usare il microfono per inserire i task vocalmente.",
          "speechRecognitionPermission": "Consenti a Cadenza di trascrivere i task dettati.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0d9af8a5-5974-4adc-848c-517208b6d8c1"
      }
    },
    "owner": "pinzino"
  }
}
